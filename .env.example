# Database connection for Prisma
# Get this from Supabase Dashboard: Settings > Database > Connection strings
# Use the transaction mode (port 6543) for serverless environments (Vercel)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"

# Supabase public credentials
# Get these from Supabase Dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_ANON_PUBLIC_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# App configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="El Tesorito de Jalisco"
NEXT_PUBLIC_SYSTEM_NAME="TesoritoOS"
NEXT_PUBLIC_THEME_PRIMARY_COLOR="#FFB7CE"
NEXT_PUBLIC_THEME_SECONDARY_COLOR="#FFD1DC"
NEXT_PUBLIC_THEME_DARK_BG_COLOR="#121212"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend Email Configuration
RESEND_API_KEY="re_..."

# Web Push Notifications (VAPID Keys)
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:alerts@trykittn.com"

# AWS S3 Storage
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET_NAME="kittnos"
AWS_S3_CUSTOM_DOMAIN="" # Optional: e.g. cdn.trykittn.com
